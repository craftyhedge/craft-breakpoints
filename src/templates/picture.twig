{#
    Breakpoints - Picture Element Template

    Template variables provided by the plugin:
    - image: Craft image element
    - config: Image configuration array
    - pictureAttributes: Attributes for the <picture> element
    - imgAttributes: Attributes for the <img> element
    - breakpoints: Breakpoint map from plugin configuration
#}

<picture {% for attr, value in pictureAttributes %}{% if value is not null and value is not empty %}{{ attr }}="{{ value }}" {% endif %}{% endfor %}>
    {% for key, breakpoint in breakpoints %}
        {% set breakpointData = craft.images.getBreakpointData(loop.index0, breakpoint, config, image) %}

        {% if breakpointData.primaryFormat %}
            <source {% for attr, value in breakpointData.primarySourceAttributes %}{% if value is not null and value is not empty %}{{ attr }}="{{ value }}" {% endif %}{% endfor %}>

            {% if breakpointData.secondaryFormat %}
                <source {% for attr, value in breakpointData.secondarySourceAttributes %}{% if value is not null and value is not empty %}{{ attr }}="{{ value }}" {% endif %}{% endfor %}>
            {% endif %}
        {% endif %}
    {% endfor %}

    <img {% for attr, value in imgAttributes %}{% if value is not null and value is not empty %}{{ attr }}="{{ value }}" {% endif %}{% endfor %}>
</picture>
