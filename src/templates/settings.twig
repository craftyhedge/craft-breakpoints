{% macro warning(key, file) -%}
    {%- set configArray = craft.app.config.getConfigFromFile(file) -%}
    {%- if configArray[key] is defined -%}
        {{- "This is being overridden by the <span style='font-weight: 600;'>`#{ key }`</span> setting in the <span style='font-weight: 600;'>`config/#{ file }.php`</span> file."|raw }}
    {%- endif -%}
{%- endmacro %}

{% import '_includes/forms' as forms %}
{% set configFileName = 'breakpoints' %}
{% set useTabs = useTabs ?? false %}
{% set selectedTab = selectedTab ?? (craft.app.request.getParam('tab') ?? 'formats') %}

{% set pictureTemplatePathValue = settings.pictureTemplatePath ?? '' %}
{% if pictureTemplatePathValue == 'breakpoints/picture.twig' %}
    {% set pictureTemplatePathValue = '' %}
{% endif %}

{% set svgTemplatePathValue = settings.svgTemplatePath ?? '' %}
{% if svgTemplatePathValue == 'breakpoints/svg.twig' %}
    {% set svgTemplatePathValue = '' %}
{% endif %}

<div id="formats" {% if useTabs and selectedTab != 'formats' %}class="hidden"{% endif %}>
    <h2>Output Formats & Quality</h2>

    {{ forms.selectField({
        label: "Format",
        instructions: "The main image format. \n WEBP or AVIF are best.",
        name: "settings[format]",
        options: [
            { label: "AVIF", value: "avif" },
            { label: "WEBP", value: "webp" },
            { label: "JPG", value: "jpg" },
            { label: "PNG", value: "png" },
            { label: "GIF", value: "gif" }
        ],
        value: settings.format,
        errors: settings.getErrors('format'),
        warning: _self.warning('format', configFileName)
    }) }}

    {{ forms.selectField({
        label: "Secondary Format",
        instructions: "If you want to have a fallback, JPEG or PNG have reliable browser coverage.",
        name: "settings[secondaryFormat]",
        options: [
            { label: "None", value: "none" },
            { label: "JPG", value: "jpg" },
            { label: "PNG", value: "png" },
            { label: "WEBP", value: "webp" },
            { label: "AVIF", value: "avif" },
            { label: "GIF", value: "gif" }
        ],
        value: settings.secondaryFormat,
        errors: settings.getErrors('secondaryFormat'),
        warning: _self.warning('secondaryFormat', configFileName)
    }) }}

    {{ forms.selectField({
        label: "Quality",
        instructions: "The higher the quality, the larger the file size.",
        name: "settings[quality]",
        options: [
            { label: "100", value: "100" },
            { label: "90", value: "90" },
            { label: "80", value: "80" },
            { label: "70", value: "70" },
            { label: "60", value: "60" },
            { label: "50", value: "50" },
            { label: "40", value: "40" },
            { label: "30", value: "30" },
            { label: "20", value: "20" },
            { label: "10", value: "10" }
        ],
        value: settings.quality,
        errors: settings.getErrors('quality'),
        warning: _self.warning('quality', configFileName)
    }) }}

    {{ forms.selectField({
        label: "Interlace",
        instructions: "Progressive rendering of images. \n Supported by GIF, PNG, and JPEG.",
        name: "settings[interlace]",
        options: [
            { label: "None", value: "none" },
            { label: "Line", value: "line" },
            { label: "Plane", value: "plane" },
            { label: "Partition", value: "partition" }
        ],
        value: settings.interlace,
        errors: settings.getErrors('interlace'),
        warning: _self.warning('interlace', configFileName)
    }) }}

    <h3>Device Pixel Ratio (DPR)</h3>

    {{ forms.checkboxGroupField({
        label: "DPR Ratios",
        instructions: "Generate images for different pixel densities. 1x is always enabled. </br><em style='color: #6b7280; font-size: 13px;'>Higher ratios = larger files. 2x covers most retina displays.</em>",
        name: "settings[dpr]",
        options: [
            { label: "1x (Standard)", value: "1", disabled: true },
            { label: "2x (Retina)", value: "2" },
            { label: "3x (Eagles)", value: "3" }
        ],
        values: (settings.dpr ?? [1])|map(d => d|string),
        errors: settings.getErrors('dpr'),
        warning: _self.warning('dpr', configFileName)
    }) }}

    <style>
        input[name="settings[dpr][]"][value="1"]:disabled + label {
            opacity: 0.7;
        }
    </style>
</div>

<div id="loading" {% if useTabs and selectedTab != 'loading' %}class="hidden"{% endif %}>
    <h2>Loading</h2>

    {{ forms.lightswitchField({
        label: "Native Lazy Loading",
        instructions: "Enable native browser lazy loading on images. </br><em style='color: #6b7280; font-size: 13px;'>Disable if using a JavaScript lazy-loading library. Requires custom implementation (e.g., lazysizes, lozad).</em>",
        id: 'nativeLazyLoadingEnabled',
        name: "settings[nativeLazyLoadingEnabled]",
        on: settings.nativeLazyLoadingEnabled ?? true,
        value: settings.nativeLazyLoadingEnabled ?? true,
        disabled: false,
        errors: settings.getErrors('nativeLazyLoadingEnabled'),
        warning: _self.warning('nativeLazyLoadingEnabled', configFileName)
    }) }}

    {{ forms.selectField({
        label: "Processing Lazy-Loading Adapter",
        instructions: "Controls how the processing preview activates JavaScript lazy-loaded images. Selection is explicit; processing does not auto-detect libraries.",
        id: 'processingLazyLoadingAdapter',
        name: "settings[processingLazyLoadingAdapter]",
        options: [
            { label: "Attribute swap (default)", value: "attributes" },
            { label: "None", value: "none" },
            { label: "lazysizes", value: "lazysizes" },
            { label: "Vanilla LazyLoad", value: "vanilla-lazyload" },
            { label: "Lozad", value: "lozad" },
            { label: "Custom async handler", value: "custom" }
        ],
        value: settings.processingLazyLoadingAdapter ?? 'attributes',
        errors: settings.getErrors('processingLazyLoadingAdapter'),
        warning: _self.warning('processingLazyLoadingAdapter', configFileName)
    }) }}

    <div id="processing-lazy-loading-attributes">
        {{ forms.textField({
            label: "Source Attribute",
            instructions: "Attribute copied to `src` during processing.",
            name: "settings[processingLazyLoadingSrcAttribute]",
            value: settings.processingLazyLoadingSrcAttribute ?? 'data-src',
            placeholder: "data-src",
            errors: settings.getErrors('processingLazyLoadingSrcAttribute'),
            warning: _self.warning('processingLazyLoadingSrcAttribute', configFileName)
        }) }}

        {{ forms.textField({
            label: "Source Set Attribute",
            instructions: "Attribute copied to `srcset` during processing.",
            name: "settings[processingLazyLoadingSrcsetAttribute]",
            value: settings.processingLazyLoadingSrcsetAttribute ?? 'data-srcset',
            placeholder: "data-srcset",
            errors: settings.getErrors('processingLazyLoadingSrcsetAttribute'),
            warning: _self.warning('processingLazyLoadingSrcsetAttribute', configFileName)
        }) }}

        {{ forms.textField({
            label: "Sizes Attribute",
            instructions: "Attribute copied to `sizes` during processing.",
            name: "settings[processingLazyLoadingSizesAttribute]",
            value: settings.processingLazyLoadingSizesAttribute ?? 'data-sizes',
            placeholder: "data-sizes",
            errors: settings.getErrors('processingLazyLoadingSizesAttribute'),
            warning: _self.warning('processingLazyLoadingSizesAttribute', configFileName)
        }) }}
    </div>

    <div id="processing-lazy-loading-lazysizes">
        <h3>lazysizes Processing Calls</h3>
        <ul>
            <li><code>window.lazySizes.loader.checkElems()</code></li>
            <li><code>window.lazySizes.autoSizer.checkElems()</code></li>
            <li><code>window.lazySizes.loader.unveil(image)</code> for each <code>img.lazyload</code></li>
        </ul>
    </div>

    <div id="processing-lazy-loading-vanilla-lazyload">
        <h3>Vanilla LazyLoad Processing Calls</h3>
        <ul>
            <li><code>instance.update()</code></li>
            <li><code>instance.loadAll()</code></li>
            <li><code>instance.load(image)</code> for each lazy image</li>
            <li><code>window.LazyLoad.load(image)</code> when the static API is available</li>
        </ul>
        <p class="light">Recognized instance globals: <code>lazyLoadInstance</code>, <code>__lazyLoadInstance</code>, <code>lazyLoadInstances</code>, and <code>__lazyLoadInstances</code>.</p>
    </div>

    <div id="processing-lazy-loading-lozad">
        <h3>Lozad Processing Calls</h3>
        <ul>
            <li><code>instance.observe()</code></li>
            <li><code>instance.triggerLoad(element)</code> for each <code>.lozad</code> element</li>
            <li><code>window.lozad('.lozad')</code>, followed by <code>observe()</code> and <code>triggerLoad(element)</code>, when no observer instance is exposed</li>
        </ul>
        <p class="light">Recognized instance globals: <code>lozadObserver</code>, <code>lozadInstance</code>, <code>__lozadObserver</code>, <code>__lozadInstance</code>, <code>lozadObservers</code>, and <code>__lozadObservers</code>.</p>
    </div>

    <div id="processing-lazy-loading-custom">
        {{ forms.textField({
            label: "Custom Handler",
            instructions: "Global async JavaScript function called inside the preview frame, for example `window.project.prepareBreakpointImages`. Standard configured source attributes are tracked while the handler activates them.",
            name: "settings[processingLazyLoadingCustomHandler]",
            value: settings.processingLazyLoadingCustomHandler ?? '',
            placeholder: "window.project.prepareBreakpointImages",
            errors: settings.getErrors('processingLazyLoadingCustomHandler'),
            warning: _self.warning('processingLazyLoadingCustomHandler', configFileName)
        }) }}
    </div>
</div>

<div id="behavior" {% if useTabs and selectedTab != 'behavior' %}class="hidden"{% endif %}>
    <h2>Transform Settings & Defaults</h2>

    {{ forms.selectField({
        label: "Mode",
        instructions: "How images are resized to fit the container. \n Crop mode is the most used and recommended.",
        name: "settings[mode]",
        options: [
            { label: "Crop", value: "crop" },
            { label: "Fit", value: "fit" },
            { label: "LetterBox", value: "letterBox" },
            { label: "Stretch", value: "stretch" },
        ],
        value: settings.mode,
        errors: settings.getErrors('mode'),
        warning: _self.warning('mode', configFileName)
    }) }}

    {% set allowUpscaleEnabled = (settings.allowUpscale ?? 0) ? true : false %}
    {{ forms.lightswitchField({
        label: "Allow Upscaling",
        instructions: "Whether or not Craft is allowed to scale an image beyond its original dimensions. \n Recommended to keep this off.",
        id: 'allowUpscale',
        name: "settings[allowUpscale]",
        value: allowUpscaleEnabled,
        on: allowUpscaleEnabled,
        errors: settings.getErrors('allowUpscale'),
        warning: _self.warning('allowUpscale', configFileName)
    }) }}

    <h3>Default Transform Dimensions</h3>
    <p class="instructions">Fallbacks for when no initial dimensions are provided. Superseded by applied transforms.
        </br>
        <em style='color: #6b7280; font-size: 13px;'>The starting transform can effect the rendered image dimensions depending on your styling.</em> </br>
        <em style='color: #6b7280; font-size: 13px;'>The intitial dimensions can also be set at the template level.</em>
    </p>

    {{ forms.textField({
        label: "Default Width",
        instructions: "",
        name: "settings[defaultWidth]",
        value: settings.defaultWidth,
        errors: settings.getErrors('defaultWidth'),
        warning: _self.warning('defaultWidth', configFileName)
    }) }}

    {{ forms.textField({
        label: "Default Height",
        instructions: "",
        name: "settings[defaultHeight]",
        value: settings.defaultHeight,
        errors: settings.getErrors('defaultHeight'),
        warning: _self.warning('defaultHeight', configFileName)
    }) }}
</div>

<div id="editor" {% if useTabs and selectedTab != 'editor' %}class="hidden"{% endif %}>
    <h2>Editor Preview UI</h2>

    {{ forms.lightswitchField({
        label: "Center Preview Width",
        instructions: "Controls preview alignment in Process and Review. When on, preview width uses margin: auto.",
        id: 'previewCenter',
        name: "settings[previewCenter]",
        on: settings.previewCenter ?? true,
        value: settings.previewCenter ?? true,
        errors: settings.getErrors('previewCenter'),
        warning: _self.warning('previewCenter', configFileName)
    }) }}
</div>

<div id="templates" {% if useTabs and selectedTab != 'templates' %}class="hidden"{% endif %}>
    <h2>Template Customization</h2>

    {{ forms.textField({
        label: "Custom Picture Template Path",
        instructions: "Path relative to templates folder. Leave blank for default plugin template.",
        name: "settings[pictureTemplatePath]",
        value: pictureTemplatePathValue,
        disabled: false,
        placeholder: "e.g. _partials/picture.twig",
        errors: settings.getErrors('pictureTemplatePath'),
        warning: _self.warning('pictureTemplatePath', configFileName)
    }) }}

    {{ forms.textField({
        label: "Custom SVG Template Path",
        instructions: "Path relative to templates folder. Leave blank for default plugin template.",
        name: "settings[svgTemplatePath]",
        value: svgTemplatePathValue,
        disabled: false,
        placeholder: "e.g. _partials/svg.twig",
        errors: settings.getErrors('svgTemplatePath'),
        warning: _self.warning('svgTemplatePath', configFileName)
    }) }}
</div>

<div id="database" {% if useTabs and selectedTab != 'database' %}class="hidden"{% endif %}>
    <h2>{{ 'Database'|t('breakpoints') }}</h2>

    <h3>{{ 'Clear observations'|t('breakpoints') }}</h3>
    <p class="instructions warning">{{ 'Removes observed transform usage rows only. Run snapshots and preview cache are preserved.'|t('breakpoints') }}</p>
    <div class="buttons">
        {{ forms.button({
            label: 'Clear observations'|t('breakpoints'),
            icon: 'trash',
            spinner: true,
            busyMessage: 'Clearing…'|t('breakpoints'),
            class: ['secondary'],
            attributes: {
                data: {
                    'bpts-db-action': 'clear-observations',
                    'bpts-db-confirm': 'Permanently clear observed transform usage rows? This cannot be undone.'|t('breakpoints'),
                },
            },
        }) }}
    </div>

    <hr>

    <h3>{{ 'Clear all plugin data'|t('breakpoints') }}</h3>
    <p class="instructions warning">{{ 'Empties every plugin-owned table. Transform configuration is preserved, but telemetry, snapshots, and preview cache are removed.'|t('breakpoints') }}</p>
    <div class="buttons">
        {{ forms.button({
            label: 'Clear all'|t('breakpoints'),
            icon: 'trash',
            spinner: true,
            busyMessage: 'Clearing…'|t('breakpoints'),
            class: ['secondary'],
            attributes: {
                data: {
                    'bpts-db-action': 'clear-all',
                    'bpts-db-confirm': 'Permanently clear ALL plugin data? This cannot be undone.'|t('breakpoints'),
                },
            },
        }) }}
    </div>
</div>

{% js %}
(function() {
    var lazyAdapter = document.querySelector('[name="settings[processingLazyLoadingAdapter]"]');
    var lazyAttributes = document.getElementById('processing-lazy-loading-attributes');
    var lazyCustom = document.getElementById('processing-lazy-loading-custom');
    var lazyLibrarySummaries = {
        'lazysizes': document.getElementById('processing-lazy-loading-lazysizes'),
        'vanilla-lazyload': document.getElementById('processing-lazy-loading-vanilla-lazyload'),
        'lozad': document.getElementById('processing-lazy-loading-lozad')
    };

    function updateLazyLoadingFields() {
        var adapter = lazyAdapter ? lazyAdapter.value : 'attributes';
        if (lazyAttributes) {
            lazyAttributes.hidden = adapter !== 'attributes';
        }
        if (lazyCustom) {
            lazyCustom.hidden = adapter !== 'custom';
        }
        Object.keys(lazyLibrarySummaries).forEach(function(key) {
            var summary = lazyLibrarySummaries[key];
            if (summary) {
                summary.hidden = adapter !== key;
            }
        });
    }

    if (lazyAdapter) {
        lazyAdapter.addEventListener('change', updateLazyLoadingFields);
        updateLazyLoadingFields();
    }

    if (typeof Craft === 'undefined' || !Craft.sendActionRequest) {
        return;
    }

    var actionMap = {
        'clear-observations': 'breakpoints/database/clear-observations',
        'clear-all': 'breakpoints/database/clear-all'
    };

    document.querySelectorAll('[data-bpts-db-action]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var key = btn.getAttribute('data-bpts-db-action');
            var action = actionMap[key];
            if (!action) return;

            var confirmMessage = btn.getAttribute('data-bpts-db-confirm');
            if (confirmMessage && !window.confirm(confirmMessage)) {
                return;
            }

            btn.disabled = true;
            btn.setAttribute('aria-busy', 'true');
            Craft.sendActionRequest('POST', action)
                .then(function(response) {
                    var data = response && response.data ? response.data : {};
                    if (data.message) {
                        Craft.cp.displayNotice(data.message);
                    }
                })
                .catch(function(error) {
                    var msg = (error && error.response && error.response.data && error.response.data.message)
                        ? error.response.data.message
                        : Craft.t('breakpoints', 'Database action failed.');
                    Craft.cp.displayError(msg);
                })
                .finally(function() {
                    btn.disabled = false;
                    btn.removeAttribute('aria-busy');
                });
        });
    });
})();
{% endjs %}
