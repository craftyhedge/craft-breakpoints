{% extends "_layouts/cp" %}
{% import '_includes/forms' as forms %}
{% set title = 'Transform Sets'|t('craft-breakpoint-images') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'processing' %}
{% set toolbar %}
    <div class="bpi-header-status-wrap">
        <span id="bpi-status" class="light bpi-header-status" data-role="status">Idle</span>
        <div id="bpi-progress-host" class="bpi-progress-host" aria-hidden="true" hidden></div>
    </div>
{% endset %}
{% set reviewToolbarActions %}
    {% if transformsDeveloperActionsEnabled ?? false %}
        <div class="bpi-frame-toolbar-actions bpi-page-title-actions">
            <button id="bpi-open-preview" class="btn small bpi-toolbar-icon-btn" type="button" title="Open Preview" aria-label="Open Preview" disabled>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M1.5 8s2.4-4 6.5-4 6.5 4 6.5 4-2.4 4-6.5 4-6.5-4-6.5-4z"></path>
                    <circle cx="8" cy="8" r="2"></circle>
                </svg>
            </button>
            <button id="bpi-copy-output" class="btn small bpi-copy-output-btn" type="button" title="Copy JSON" aria-label="Copy JSON" hidden>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <rect x="5" y="2.5" width="8" height="10" rx="1.5"></rect>
                    <rect x="3" y="5.5" width="8" height="8" rx="1.5"></rect>
                </svg>
            </button>
        </div>
    {% endif %}
{% endset %}

{% block pageTitle %}
    <div class="bpi-page-title-wrap">
        <h1 id="page-heading" class="screen-title" title="{{ title }}">{{ title }}</h1>
        {{ reviewToolbarActions }}
    </div>
    <div id="revision-indicators"></div>
{% endblock %}

{% block sidebar %}
    {% set transformSets = processingConfig.sets ?? {} %}
    <h2 id="bpi-results-heading" class="heading">{{ 'Saved Sets'|t('craft-breakpoint-images') }}</h2>
    <nav id="bpi-transform-sets-sidebar" aria-label="{{ 'Transform Sets'|t('craft-breakpoint-images') }}">
        <ul id="bpi-transform-sets-list">
            {% for setName in transformSets|keys %}
                <li data-set="{{ setName|e('html_attr') }}">
                    <a href="#" class="bpi-transform-sidebar-link" data-set="{{ setName|e('html_attr') }}">{{ setName }}</a>
                </li>
            {% else %}
                <li><a>{{ 'No transform sets found.'|t('craft-breakpoint-images') }}</a></li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}

{% block actionButton %}
    <div class="buttons bpi-header-controls">
        <div class="bpi-source-entry-control">
            {{ forms.elementSelect({
                id: 'bpi-source-entry',
                name: 'bpi-source-entry-id',
                elementType: 'craft\\elements\\Entry',
                selectionLabel: 'Choose Source'|t('craft-breakpoint-images'),
                single: true,
                elements: selectedSourceEntries ?? []
            }) }}
        </div>
        {{ forms.button({
            id: 'bpi-run-processing',
            label: 'Process'|t('craft-breakpoint-images'),
            disabled: true
        }) }}
        {{ forms.button({
            id: 'bpi-stop-processing',
            class: 'bpi-stop-processing',
            label: 'Quit Waiting'|t('craft-breakpoint-images'),
            attributes: {
                hidden: true
            }
        }) }}
    </div>

{% endblock %}

{% block content %}
    {% set initialBaseVersion = currentBaseVersion ?? '' %}
    <div
        class="bpi-transforms-page bpi-review-hydrating"
        data-signals="{showCardSettings: false, ui: {resultsHeading: 'Saved Sets', showWarningOrder: false, resultsOrderingNoteLabel: ''}, editor: {baseVersion: '{{ initialBaseVersion|e('js') }}', cards: {}}}"
        data-show-card-settings="0"
        data-attr:data-show-card-settings="(String($showCardSettings) === 'true' || String($showCardSettings) === '1') ? '1' : '0'"
        data-apply-card-operation-url="{{ applyCardOperationUrl }}"
        data-preview-center="{{ (previewCenter ?? true) ? '1' : '0' }}"
        data-site-id="{{ currentSite.id ?? 0 }}"
    >
        <input id="bpi-show-card-settings-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="showCardSettings">
        <input id="bpi-ui-results-heading-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsHeading">
        <input id="bpi-ui-show-warning-order-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="ui.showWarningOrder">
        <input id="bpi-ui-results-ordering-note-label-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsOrderingNoteLabel">
        <div id="bpi-frame-pane" class="bpi-frame-pane is-hidden">
            <div class="bpi-frame-toolbar">
                <strong>Preview</strong>
            </div>
            <div id="bpi-frame-wrapper" class="bpi-frame-wrapper" data-role="preview-wrapper">
                <button id="bpi-close-preview" class="btn" type="button">Close Preview</button>
            </div>
        </div>

        <div class="bpi-results-heading-wrap">
            <div class="bpi-results-settings-toggle">
                <div id="bpi-results-settings-lightswitch" class="lightswitch small bpi-results-settings-lightswitch" role="switch" tabindex="0" aria-label="{{ 'Edit'|t('craft-breakpoint-images') }}" aria-checked="false">
                    <div class="lightswitch-container">
                        <div class="handle"></div>
                    </div>
                </div>
                <span>{{ 'Edit'|t('craft-breakpoint-images') }}</span>
            </div>
        </div>

        <div class="bpi-results-pane">
            <div class="bpi-results-meta" hidden id="bpi-results-meta" data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                <span id="bpi-results-ordering-note" class="bpi-results-ordering-note" hidden data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                        <span class="bpi-results-ordering-note-icon" aria-hidden="true">{{ iconSvg('list-tree') }}</span>
                    <span id="bpi-results-ordering-note-label" data-text="$ui.resultsOrderingNoteLabel || ''"></span>
                </span>
            </div>
            <div id="bpi-visual-results" class="bpi-visual-results" aria-live="polite"></div>
        </div>
    </div>
{% endblock %}
