{% extends "_layouts/cp" %}
{% import '_includes/forms' as forms %}
{% set title = 'Process and Review'|t('craft-breakpoint-images') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'processing' %}
{% set toolbar %}
    <div class="bpi-header-status-wrap">
        <span id="bpi-status" class="light bpi-header-status" data-role="status">Idle</span>
        <div id="bpi-progress-host" class="bpi-progress-host" aria-hidden="true" hidden></div>
    </div>
{% endset %}

{% block actionButton %}
    <div class="buttons bpi-header-controls">
        <div class="bpi-source-entry-control">
            {{ forms.elementSelect({
                id: 'bpi-source-entry',
                name: 'bpi-source-entry-id',
                elementType: 'craft\\elements\\Entry',
                selectionLabel: 'Choose Source'|t('craft-breakpoint-images'),
                single: true,
                elements: selectedSourceEntries ?? []
            }) }}
        </div>
        {{ forms.button({
            id: 'bpi-run-processing',
            class: 'submit',
            label: 'Process'|t('craft-breakpoint-images'),
            disabled: true
        }) }}
        {{ forms.button({
            id: 'bpi-stop-processing',
            class: 'bpi-stop-processing',
            label: 'Quit Waiting'|t('craft-breakpoint-images'),
            attributes: {
                hidden: true
            }
        }) }}
    </div>

{% endblock %}

{% block content %}
    <div
        class="bpi-transforms-page"
        data-signals="{editor: {baseVersion: 1, cards: {}}}"
        data-apply-card-operation-url="{{ applyCardOperationUrl }}"
    >
        <div id="bpi-frame-pane" class="bpi-frame-pane is-hidden">
            <div class="bpi-frame-toolbar">
                <strong>Preview</strong>
            </div>
            <div id="bpi-frame-wrapper" class="bpi-frame-wrapper" data-role="preview-wrapper">
                <button id="bpi-close-preview" class="btn" type="button">Close Preview</button>
            </div>
        </div>

        <div class="bpi-results-pane">
            <div class="bpi-frame-toolbar">
                <strong>Result Review</strong>
                <div class="bpi-frame-toolbar-actions">
                    <button id="bpi-open-preview" class="btn small bpi-toolbar-icon-btn" type="button" title="Open Preview" aria-label="Open Preview" disabled>
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M1.5 8s2.4-4 6.5-4 6.5 4 6.5 4-2.4 4-6.5 4-6.5-4-6.5-4z"></path>
                            <circle cx="8" cy="8" r="2"></circle>
                        </svg>
                    </button>
                    <button id="bpi-copy-output" class="btn small bpi-copy-output-btn" type="button" title="Copy JSON" aria-label="Copy JSON" hidden>
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <rect x="5" y="2.5" width="8" height="10" rx="1.5"></rect>
                            <rect x="3" y="5.5" width="8" height="8" rx="1.5"></rect>
                        </svg>
                    </button>
                </div>
            </div>
            <div id="bpi-warnings" class="bpi-warning-list">
                <div class="bpi-warning-item bpi-warning-item-neutral">
                    <span class="bpi-warning-code">{{ 'Process'|t('craft-breakpoint-images') }}</span>
                    <div class="bpi-warning-detail">
                        <p>{{ 'Select an entry with images then hit process.'|t('craft-breakpoint-images') }}</p>
                    </div>
                </div>
            </div>
            <div id="bpi-visual-results" class="bpi-visual-results" aria-live="polite"></div>
        </div>
    </div>
{% endblock %}
