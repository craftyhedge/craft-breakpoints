{% extends "_layouts/cp" %}
{% import '_includes/forms' as forms %}
{% set title = 'Transform Sets'|t('craft-breakpoints') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'processing' %}
{% if canEditTransforms ?? false %}
    {% set toolbar %}
        <div class="bpts-header-status-wrap">
            <span id="bpts-status" class="light bpts-header-status" data-role="status">Idle</span>
            <div id="bpts-progress-host" class="bpts-progress-host" aria-hidden="true" hidden></div>
        </div>
    {% endset %}
{% endif %}
{% set reviewToolbarActions %}
    {% if (canEditTransforms ?? false) and (transformsDeveloperActionsEnabled ?? false) %}
        <div class="bpts-frame-toolbar-actions bpts-page-title-actions">
            <button id="bpts-open-preview" class="btn small bpts-toolbar-icon-btn" type="button" title="Open Preview" aria-label="Open Preview" disabled>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M1.5 8s2.4-4 6.5-4 6.5 4 6.5 4-2.4 4-6.5 4-6.5-4-6.5-4z"></path>
                    <circle cx="8" cy="8" r="2"></circle>
                </svg>
            </button>
            <button id="bpts-copy-output" class="btn small bpts-copy-output-btn" type="button" title="Copy JSON" aria-label="Copy JSON" hidden>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <rect x="5" y="2.5" width="8" height="10" rx="1.5"></rect>
                    <rect x="3" y="5.5" width="8" height="8" rx="1.5"></rect>
                </svg>
            </button>
        </div>
    {% endif %}
{% endset %}

{% block pageTitle %}
    <div class="bpts-page-title-wrap">
        <h1 id="page-heading" class="screen-title" title="{{ title }}">{{ title }}</h1>
        {{ reviewToolbarActions }}
        {% if canEditTransforms ?? false %}
            <div class="bpts-results-settings-toggle">
                <div id="bpts-results-settings-lightswitch" class="lightswitch small bpts-results-settings-lightswitch" role="switch" tabindex="0" aria-label="{{ 'Edit'|t('craft-breakpoints') }}" aria-checked="false">
                    <div class="lightswitch-container">
                        <div class="handle"></div>
                    </div>
                </div>
                <span>{{ 'Edit'|t('craft-breakpoints') }}</span>
            </div>
        {% endif %}
    </div>
    <div id="revision-indicators"></div>
{% endblock %}

{% block sidebar %}
    {% set sidebarRows = sidebarTransformRows ?? [] %}
    <h2 id="bpts-results-heading" class="heading">{{ 'Saved Sets'|t('craft-breakpoints') }}</h2>
    <nav id="bpts-transform-sets-sidebar" aria-label="{{ 'Transform Sets'|t('craft-breakpoints') }}">
        <ul id="bpts-transform-sets-list">
            {% for row in sidebarRows %}
                {% set isObservedUnsaved = row.isObservedUnsaved ?? false %}
                <li data-set="{{ row.name|e('html_attr') }}"
                    {% if isObservedUnsaved %}class="bpts-transform-sidebar-item-warning" data-observed-unsaved="1"{% endif %}>
                    <a href="#" class="bpts-transform-sidebar-link{% if isObservedUnsaved %} bpts-transform-sidebar-link-warning{% endif %}" data-set="{{ row.name|e('html_attr') }}">
                        {% if isObservedUnsaved %}
                            <span class="bpts-transform-sidebar-warning-icon" aria-hidden="true" title="{{ 'Observed but not saved'|t('craft-breakpoints') }}">
                                <svg viewBox="0 0 16 16" focusable="false"><path d="M8 1.5 15 14H1L8 1.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 6v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="12" r="0.9" fill="currentColor"/></svg>
                            </span>
                            <span class="visually-hidden">{{ 'Not saved:'|t('craft-breakpoints') }} </span>
                        {% endif %}
                        {{ row.name }}
                    </a>
                </li>
            {% else %}
                <li><a>{{ 'No transform sets found.'|t('craft-breakpoints') }}</a></li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}

{% block actionButton %}
    <div class="buttons bpts-header-controls"{% if not (canEditTransforms ?? false) %} hidden aria-hidden="true" style="display: none !important;"{% endif %}>
        <div class="bpts-source-entry-control"{% if not (canEditTransforms ?? false) %} hidden aria-hidden="true"{% endif %}>
            {{ forms.elementSelect({
                id: 'bpts-source-entry',
                name: 'bpts-source-entry-id',
                elementType: 'craft\\elements\\Entry',
                selectionLabel: 'Choose Source'|t('craft-breakpoints'),
                single: true,
                elements: selectedSourceEntries ?? []
            }) }}
        </div>
        {{ forms.button({
            id: 'bpts-run-processing',
            label: 'Process'|t('craft-breakpoints'),
            disabled: true,
            attributes: not (canEditTransforms ?? false) ? {
                hidden: true,
                'aria-hidden': 'true'
            } : {}
        }) }}
        {{ forms.button({
            id: 'bpts-stop-processing',
            class: 'bpts-stop-processing',
            label: 'Quit Waiting'|t('craft-breakpoints'),
            attributes: not (canEditTransforms ?? false)
                ? {
                    hidden: true,
                    'aria-hidden': 'true'
                }
                : {
                    hidden: true
                }
        }) }}
    </div>

{% endblock %}

{% block content %}
    {% set initialBaseVersion = currentBaseVersion ?? '' %}
    <div
        class="bpts-transforms-page bpts-review-hydrating"
        data-signals="{_applyCardOperationUrl: '{{ applyCardOperationUrl|e('js') }}', _csrfToken: '{{ craft.app.request.csrfToken|e('js') }}', showCardSettings: false, ui: {resultsHeading: 'Saved Sets', showWarningOrder: false, resultsOrderingNoteLabel: ''}, editor: {baseVersion: '{{ initialBaseVersion|e('js') }}', cards: {}}}"
        data-persist:craft-breakpoints-editor__session="{include: /^editor\\.cards\\./}"
        data-show-card-settings="0"
        data-attr:data-show-card-settings="(String($showCardSettings) === 'true' || String($showCardSettings) === '1') ? '1' : '0'"
        data-preview-center="{{ (previewCenter ?? true) ? '1' : '0' }}"
        data-site-id="{{ currentSite.id ?? 0 }}"
    >
        <input id="bpts-show-card-settings-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="showCardSettings">
        <input id="bpts-ui-results-heading-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsHeading">
        <input id="bpts-ui-show-warning-order-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="ui.showWarningOrder">
        <input id="bpts-ui-results-ordering-note-label-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsOrderingNoteLabel">
        <div id="bpts-editor-status" class="visually-hidden" data-kind="ready" data-message=""></div>
        <div id="bpts-frame-pane" class="bpts-frame-pane is-hidden">
            <div class="bpts-frame-toolbar">
                <strong>Preview</strong>
            </div>
            <div id="bpts-frame-wrapper" class="bpts-frame-wrapper" data-role="preview-wrapper">
                <button id="bpts-close-preview" class="btn" type="button">Close Preview</button>
            </div>
        </div>

        <div class="bpts-results-heading-wrap">
        </div>

        <div class="bpts-results-pane">
            <div class="bpts-results-meta" hidden id="bpts-results-meta" data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                <span id="bpts-results-ordering-note" class="bpts-results-ordering-note" hidden data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                        <span class="bpts-results-ordering-note-icon" aria-hidden="true">{{ iconSvg('list-tree') }}</span>
                    <span id="bpts-results-ordering-note-label" data-text="$ui.resultsOrderingNoteLabel || ''"></span>
                </span>
            </div>
            <div id="bpts-visual-results" class="bpts-visual-results" aria-live="polite"></div>
        </div>
    </div>
{% endblock %}
