{% extends "_layouts/cp" %}
{% import '_includes/forms' as forms %}
{% set title = 'Transform Sets'|t('breakpoints') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'processing' %}
{% if canEditTransforms ?? false %}
    {% set toolbar %}
        <div class="bpts-header-status-wrap">
            <span id="bpts-status" class="light bpts-header-status" data-role="status">Idle</span>
            <div id="bpts-progress-host" class="bpts-progress-host" aria-hidden="true" hidden></div>
        </div>
    {% endset %}
{% endif %}
{% set reviewToolbarActions %}
    {% if (canEditTransforms ?? false) and (transformsDeveloperActionsEnabled ?? false) %}
        <div class="bpts-frame-toolbar-actions bpts-page-title-actions">
            <button id="bpts-open-preview" class="btn small bpts-toolbar-icon-btn" type="button" title="Open Preview" aria-label="Open Preview" disabled>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M1.5 8s2.4-4 6.5-4 6.5 4 6.5 4-2.4 4-6.5 4-6.5-4-6.5-4z"></path>
                    <circle cx="8" cy="8" r="2"></circle>
                </svg>
            </button>
            <button id="bpts-copy-output" class="btn small bpts-copy-output-btn" type="button" title="Copy JSON" aria-label="Copy JSON" hidden>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <rect x="5" y="2.5" width="8" height="10" rx="1.5"></rect>
                    <rect x="3" y="5.5" width="8" height="8" rx="1.5"></rect>
                </svg>
            </button>
        </div>
    {% endif %}
{% endset %}

{% block pageTitle %}
    <div class="bpts-page-title-wrap">
        <h1 id="page-heading" class="screen-title" title="{{ title }}">{{ title }}</h1>
        {{ reviewToolbarActions }}
        {% if canEditTransforms ?? false %}
            <div class="bpts-results-settings-toggle">
                <div id="bpts-results-settings-lightswitch" class="lightswitch small bpts-results-settings-lightswitch" role="switch" tabindex="0" aria-label="{{ 'Edit'|t('breakpoints') }}" aria-checked="false">
                    <div class="lightswitch-container">
                        <div class="handle"></div>
                    </div>
                </div>
                <span>{{ 'Edit'|t('breakpoints') }}</span>
            </div>
        {% endif %}
    </div>
    <div id="revision-indicators"></div>
{% endblock %}

{% block sidebar %}
    {% set sidebarRows = sidebarTransformRows ?? [] %}
    <h2 id="bpts-results-heading" class="heading">{{ 'Saved Sets'|t('breakpoints') }}</h2>
    <nav id="bpts-transform-sets-sidebar" aria-label="{{ 'Transform Sets'|t('breakpoints') }}">
        <ul id="bpts-transform-sets-list">
            {% for row in sidebarRows %}
                <li data-set="{{ row.name|e('html_attr') }}">
                    <a href="#" class="bpts-transform-sidebar-link" data-set="{{ row.name|e('html_attr') }}">
                        {{ row.name }}
                    </a>
                </li>
            {% else %}
            {% endfor %}
        </ul>
    </nav>
{% endblock %}

{% block actionButton %}
    <div class="buttons bpts-header-controls"{% if not (canEditTransforms ?? false) %} hidden aria-hidden="true" style="display: none !important;"{% endif %}>
        <button id="bpts-compact-breakpoint-cards" class="bpts-compact-breakpoint-cards" type="button" aria-pressed="false" title="{{ 'Hide previews'|t('breakpoints') }}" aria-label="{{ 'Hide previews'|t('breakpoints') }}">
            <span class="icon bpts-compact-breakpoint-cards-icon bpts-compact-breakpoint-cards-icon-expanded" data-icon="view" aria-hidden="true"></span>
            <span class="icon bpts-compact-breakpoint-cards-icon bpts-compact-breakpoint-cards-icon-compact" data-icon="eye-slash" aria-hidden="true"></span>
        </button>
        <div class="bpts-source-entry-control"{% if not (canEditTransforms ?? false) %} hidden aria-hidden="true"{% endif %}>
            {% set initialSourceMode = (selectedSourceUrl ?? '') is not empty ? 'url' : 'entry' %}
            {{ forms.buttonGroup({
                id: 'bpts-source-mode-toggle',
                name: 'bpts-source-mode',
                value: initialSourceMode,
                class: ['bpts-source-mode-toggle'],
                options: [
                    { label: 'Entry'|t('breakpoints'), value: 'entry', class: ['small'] },
                    { label: 'URL'|t('breakpoints'), value: 'url', class: ['small'] },
                ],
            }) }}
            {{ forms.elementSelect({
                id: 'bpts-source-entry',
                name: 'bpts-source-entry-id',
                elementType: 'craft\\elements\\Entry',
                selectionLabel: 'Choose Source'|t('breakpoints'),
                single: true,
                elements: selectedSourceEntries ?? [],
                containerAttributes: {
                    data: {
                        'bpts-source-entry-wrap': true,
                    },
                    hidden: initialSourceMode == 'url',
                }
            }) }}
            <input
                type="text"
                id="bpts-source-url"
                class="text bpts-source-url"
                value="{{ selectedSourceUrl ?? '' }}"
                placeholder="{{ '/path-or-full-url'|t('breakpoints') }}"
                aria-label="{{ 'Source URL'|t('breakpoints') }}"
                {% if initialSourceMode != 'url' %}hidden{% endif %}
            >
        </div>
        {{ forms.button({
            id: 'bpts-run-processing',
            label: 'Process'|t('breakpoints'),
            disabled: true,
            attributes: not (canEditTransforms ?? false) ? {
                hidden: true,
                'aria-hidden': 'true'
            } : {}
        }) }}
        {{ forms.button({
            id: 'bpts-stop-processing',
            class: 'bpts-stop-processing',
            label: 'Quit Waiting'|t('breakpoints'),
            attributes: not (canEditTransforms ?? false)
                ? {
                    hidden: true,
                    'aria-hidden': 'true'
                }
                : {
                    hidden: true
                }
        }) }}
    </div>

{% endblock %}

{% block content %}
    {% set initialCompactBreakpointCards = not (canEditTransforms ?? false) %}
    {% set initialBaseVersion = currentBaseVersion ?? '' %}
    {% set initialSavedSetNames = [] %}
    {% for row in (sidebarTransformRows ?? []) %}
        {% if (row.name ?? '') is not empty %}
            {% set initialSavedSetNames = initialSavedSetNames|merge([row.name]) %}
        {% endif %}
    {% endfor %}
    <div
        class="bpts-transforms-page bpts-review-hydrating"
        data-signals="{_applyCardOperationUrl: '{{ applyCardOperationUrl|e('js') }}', _renderTransformCardUrl: '{{ renderTransformCardUrl|e('js') }}', _csrfToken: '{{ craft.app.request.csrfToken|e('js') }}', showCardSettings: false, compactBreakpointCards: {{ initialCompactBreakpointCards ? 'true' : 'false' }}, ui: {resultsHeading: 'Saved Sets', showWarningOrder: false, resultsOrderingNoteLabel: ''}, sidebar: {savedSetNamesJson: '{{ initialSavedSetNames|json_encode|e('js') }}'}, editor: {baseVersion: '{{ initialBaseVersion|e('js') }}', cards: {}}}"
        data-on-signal-patch="window.bptsSyncPostPatchReviewState && window.bptsSyncPostPatchReviewState(patch)"
        data-on-signal-patch-filter="{include: /^(editor\.baseVersion|sidebar\.savedSetNamesJson|ui\.)/}"
        data-persist:breakpoints-editor__session="{include: /^(showCardSettings|editor\\.cards\\.[^.]+\\.selectedAssetKey)$/}"
        data-show-card-settings="0"
        data-attr:data-show-card-settings="(String($showCardSettings) === 'true' || String($showCardSettings) === '1') ? '1' : '0'"
        data-compact-breakpoint-cards="{{ initialCompactBreakpointCards ? '1' : '0' }}"
        data-attr:data-compact-breakpoint-cards="(String($compactBreakpointCards) === 'true' || String($compactBreakpointCards) === '1') ? '1' : '0'"
        data-can-edit-transforms="{{ (canEditTransforms ?? false) ? '1' : '0' }}"
        data-preview-center="{{ (previewCenter ?? true) ? '1' : '0' }}"
        data-site-id="{{ currentSite.id ?? 0 }}"
    >
        <input id="bpts-show-card-settings-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="showCardSettings">
        <input id="bpts-compact-breakpoint-cards-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="compactBreakpointCards">
        <input id="bpts-ui-results-heading-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsHeading">
        <input id="bpts-ui-show-warning-order-signal-bridge" type="checkbox" hidden aria-hidden="true" tabindex="-1" data-bind="ui.showWarningOrder">
        <input id="bpts-ui-results-ordering-note-label-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="ui.resultsOrderingNoteLabel">
        <input id="bpts-sidebar-saved-set-names-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="sidebar.savedSetNamesJson">
        <input id="bpts-editor-base-version-signal-bridge" type="text" hidden aria-hidden="true" tabindex="-1" data-bind="editor.baseVersion">
        <div id="bpts-editor-status" class="visually-hidden" data-kind="ready" data-message=""></div>
        <div id="bpts-frame-pane" class="bpts-frame-pane is-hidden">
            <div class="bpts-frame-toolbar">
                <strong>Preview</strong>
            </div>
            <div id="bpts-frame-wrapper" class="bpts-frame-wrapper" data-role="preview-wrapper">
                <div class="bpts-preview-controls">
                    {% if (canEditTransforms ?? false) and (transformsDeveloperActionsEnabled ?? false) %}
                        {{ forms.button({
                            id: 'bpts-preview-run-processing',
                            label: 'Process'|t('breakpoints'),
                            disabled: true
                        }) }}
                        {{ forms.button({
                            id: 'bpts-preview-stop-processing',
                            class: 'bpts-stop-processing bpts-preview-stop-processing',
                            label: 'Quit Waiting'|t('breakpoints'),
                            attributes: {
                                hidden: true
                            }
                        }) }}
                    {% endif %}
                    <button id="bpts-close-preview" class="btn" type="button">Close Preview</button>
                </div>
            </div>
        </div>

        <div class="bpts-results-heading-wrap">
            <span id="bpts-review-state-label" class="bpts-review-state-label" data-text="$ui.resultsHeading || ''">
                {{ 'Saved Sets'|t('breakpoints') }}
            </span>
        </div>

        <div class="bpts-results-pane">
            <div class="bpts-results-meta" hidden id="bpts-results-meta" data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                <span id="bpts-results-ordering-note" class="bpts-results-ordering-note" hidden data-attr:hidden="$ui.showWarningOrder === true ? false : true">
                        <span class="bpts-results-ordering-note-icon" aria-hidden="true">{{ iconSvg('list-tree') }}</span>
                    <span id="bpts-results-ordering-note-label" data-text="$ui.resultsOrderingNoteLabel || ''"></span>
                </span>
            </div>
            <div id="bpts-visual-results" class="bpts-visual-results" aria-live="polite"></div>
        </div>
    </div>
{% endblock %}
