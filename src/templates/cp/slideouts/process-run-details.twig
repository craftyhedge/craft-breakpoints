{% set snapshot = snapshot ?? null %}
{% set runEntry = runEntry ?? null %}
{% set canProcessAgain = canProcessAgain ?? false %}
{% set processAgainDisabledReason = processAgainDisabledReason ?? '' %}
{% set otherTransformHandles = otherTransformHandles ?? [] %}
{% set lastObserved = lastObserved ?? null %}
{% set lastObservedEntry = lastObservedEntry ?? null %}
{% set breakpointRows = breakpointRows ?? [] %}
{% set statusCounts = statusCounts ?? {} %}
{% set transformHandle = transformHandle ?? '' %}
{% set healthStatusClass = healthStatusClass ?? 'unknown' %}
{% set healthStatusIcon = healthStatusIcon ?? 'alert' %}
{% set healthStatusLabel = healthStatusLabel ?? ('No Health Data'|t('craft-breakpoint-images')) %}
{% set loadedCount = statusCounts.loaded ?? 0 %}
{% set brokenCount = statusCounts.broken ?? 0 %}
{% set unresolvedCount = statusCounts.unresolved ?? 0 %}
{% set disabledCount = statusCounts.disabled ?? 0 %}
{% set unprocessedCount = statusCounts.unprocessed ?? 0 %}

<div class="bpi-process-details-screen">
    {% if snapshot %}
        <div class="bpi-process-details-card bpi-process-details-summary-card">
            <div class="bpi-process-details-summary-top">
                <div class="bpi-process-details-summary-primary">
                    <div class="bpi-process-details-run-status bpi-process-details-run-status-{{ healthStatusClass }}">
                        <span data-icon="{{ healthStatusIcon }}" aria-hidden="true"></span>
                        <span>{{ healthStatusLabel }}</span>
                    </div>
                    <div class="bpi-process-details-counts bpi-process-details-counts-inline" aria-label="{{ 'Run totals'|t('craft-breakpoint-images') }}">
                        {% if loadedCount > 0 %}
                            <span class="bpi-process-details-count-pill bpi-process-details-count-loaded">{{ 'Loaded'|t('craft-breakpoint-images') }}: {{ loadedCount }}</span>
                        {% endif %}
                        {% if brokenCount > 0 %}
                            <span class="bpi-process-details-count-pill bpi-process-details-count-broken">{{ 'Broken'|t('craft-breakpoint-images') }}: {{ brokenCount }}</span>
                        {% endif %}
                        {% if unresolvedCount > 0 %}
                            <span class="bpi-process-details-count-pill bpi-process-details-count-unresolved">{{ 'Unresolved'|t('craft-breakpoint-images') }}: {{ unresolvedCount }}</span>
                        {% endif %}
                        {% if disabledCount > 0 %}
                            <span class="bpi-process-details-count-pill bpi-process-details-count-disabled">{{ 'Disabled'|t('craft-breakpoint-images') }}: {{ disabledCount }}</span>
                        {% endif %}
                        {% if unprocessedCount > 0 %}
                            <span class="bpi-process-details-count-pill bpi-process-details-count-unprocessed">{{ 'Unprocessed'|t('craft-breakpoint-images') }}: {{ unprocessedCount }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="bpi-process-details-summary-actions">
                    <button
                        type="button"
                        class="btn small bpi-process-again-button{% if not canProcessAgain %} disabled{% endif %}"
                        data-bpi-process-again="true"
                        {% if runEntry %}data-entry-id="{{ runEntry.id }}"{% endif %}
                        {% if not canProcessAgain %}disabled aria-disabled="true"{% endif %}
                    >
                        {{ 'Process Again'|t('craft-breakpoint-images') }}
                    </button>
                    {% if not canProcessAgain and processAgainDisabledReason %}
                        <p class="light bpi-process-details-action-note">{{ processAgainDisabledReason }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="meta read-only bpi-process-details-meta-block">
                <table class="data fullwidth bpi-process-details-table">
                    <tbody>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Execution Status'|t('craft-breakpoint-images') }}</th>
                            <td>{{ snapshot.runStatus ?? 'unknown' }}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Completed At'|t('craft-breakpoint-images') }}</th>
                            <td>
                                {% if snapshot.ranAt %}
                                    {{ snapshot.ranAt|date('Y-m-d') }} <span class="light">{{ snapshot.ranAt|date('H:i:s') }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Duration'|t('craft-breakpoint-images') }}</th>
                            <td>{{ snapshot.durationMs ?? 0 }} ms</td>
                        </tr>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Run ID'|t('craft-breakpoint-images') }}</th>
                            <td><code>{{ snapshot.runId ?? '-' }}</code></td>
                        </tr>
                        {% if transformHandle != '' %}
                            <tr>
                                <th scope="row" class="nowrap">{{ 'Transform'|t('craft-breakpoint-images') }}</th>
                                <td><code>{{ transformHandle }}</code></td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Other Transforms In Run'|t('craft-breakpoint-images') }}</th>
                            <td>
                                {% if otherTransformHandles|length %}
                                    {% for name in otherTransformHandles %}
                                        <code>{{ name }}</code>{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Entry'|t('craft-breakpoint-images') }}</th>
                            <td>
                                {% if runEntry %}
                                    <a
                                        class="bpi-entry-link"
                                        href="{{ runEntry.cpEditUrl ?? '#' }}"
                                        title="{{ 'Open entry in side panel'|t('craft-breakpoint-images') }}"
                                        data-bpi-open-entry="true"
                                        data-entry-id="{{ runEntry.id }}"
                                        data-site-id="{{ runEntry.siteId }}"
                                    >
                                        {{ elementChip(runEntry, {
                                            size: 'small',
                                        }) }}
                                    </a>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bpi-process-details-card bpi-process-details-context-card">
            <h2 class="bpi-process-details-heading">{{ 'Last Observed Usage'|t('craft-breakpoint-images') }}</h2>
            <div class="meta read-only bpi-process-details-meta-block">
                <table class="data fullwidth bpi-process-details-table">
                    <tbody>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Time'|t('craft-breakpoint-images') }}</th>
                            <td>
                                {% if lastObserved and lastObserved.lastSeenAt %}
                                    {{ lastObserved.lastSeenAt|date('Y-m-d') }} <span class="light">{{ lastObserved.lastSeenAt|date('H:i:s') }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="nowrap">{{ 'Entry'|t('craft-breakpoint-images') }}</th>
                            <td>
                                <div class="bpi-process-details-entry-row">
                                {% if lastObservedEntry %}
                                    <a
                                        class="bpi-entry-link"
                                        href="{{ lastObservedEntry.cpEditUrl ?? '#' }}"
                                        title="{{ 'Open entry in side panel'|t('craft-breakpoint-images') }}"
                                        data-bpi-open-entry="true"
                                        data-entry-id="{{ lastObservedEntry.id }}"
                                        data-site-id="{{ lastObservedEntry.siteId }}"
                                    >
                                        {{ elementChip(lastObservedEntry, {
                                            size: 'small',
                                        }) }}
                                    </a>
                                {% else %}
                                    <span class="light">{{ 'Entry unavailable'|t('craft-breakpoint-images') }}</span>
                                {% endif %}
                                {% if lastObserved and lastObserved.sourceUrl %}
                                    <a
                                        class="bpi-process-details-observed-url-icon"
                                        href="{{ lastObserved.sourceUrl }}"
                                        target="_blank"
                                        rel="noopener"
                                        title="{{ 'Open observed URL'|t('craft-breakpoint-images') }}"
                                        aria-label="{{ 'Open observed URL'|t('craft-breakpoint-images') }}"
                                    >
                                        <span data-icon="world" aria-hidden="true"></span>
                                    </a>
                                {% endif %}
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bpi-process-details-card bpi-process-details-breakpoints-card">
            <h2 class="bpi-process-details-heading">{{ 'Breakpoints'|t('craft-breakpoint-images') }}</h2>

            <div class="tablepane bpi-process-details-tablepane">
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th scope="col" class="nowrap">{{ 'Breakpoint'|t('craft-breakpoint-images') }}</th>
                            <th scope="col" class="nowrap">{{ 'Status'|t('craft-breakpoint-images') }}</th>
                            <th scope="col">{{ 'Mismatch Details'|t('craft-breakpoint-images') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if breakpointRows|length %}
                            {% for row in breakpointRows %}
                                <tr>
                                    <td class="nowrap">{{ row.breakpointWidth ?? '-' }}px</td>
                                    <td class="nowrap">{{ row.statusLabel ?? 'Matching' }}</td>
                                    <td class="bpi-process-details-mismatch-cell">{{ row.mismatchInfo ?? '-' }}</td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="3" class="light">{{ 'No saved breakpoint rows found for this transform in the latest run.'|t('craft-breakpoint-images') }}</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <p class="light">{{ 'No saved processing run is available yet.'|t('craft-breakpoint-images') }}</p>
    {% endif %}
</div>

