{#
    Last-process panel (aside).

    Variables:
      - hasSnapshot         (bool)
      - statusIconClass     (string)
      - statusLabel         (string)
      - statusIconName      (string)
      - ranAtLabel          (string)
      - runEntry            (map|null)   expects { id, title, cpEditUrl, siteId, canProcessAgain }
      - runSourceUrl        (string)
#}
{%- if not hasSnapshot -%}
<aside class="bpts-transform-last-process-pane"><div class="bpts-transform-last-process-header"><span class="bpts-transform-last-process-status-icon bpts-transform-last-process-status-icon-unknown" aria-label="Unknown" title="Unknown"><span data-icon="alert" aria-hidden="true"></span></span></div><p class="light bpts-transform-last-process-empty">No saved run data yet.</p></aside>
{%- else -%}
    {%- set statusTitle = (ranAtLabel != '' and ranAtLabel != '-') ? statusLabel ~ ' (last run: ' ~ ranAtLabel ~ ')' : statusLabel -%}
<aside class="bpts-transform-last-process-pane"><span class="bpts-transform-last-process-status-icon {{ statusIconClass }}" aria-label="{{ statusTitle }}" title="{{ statusTitle }}"><span data-icon="{{ statusIconName }}" aria-hidden="true"></span></span>
    {%- if runEntry is not null and (runEntry.id ?? 0) > 0 -%}
        {%- set runTitle = (runEntry.title ?? '')|trim -%}
        {%- set runTooltip = runTitle != '' ? 'Processed entry: ' ~ runTitle : 'Open processed entry' -%}
{% include 'breakpoints/cp/_partials/review/entry-link' with {
    id: runEntry.id,
    href: (runEntry.cpEditUrl ?? '#')|trim ?: '#',
    siteId: max(0, (runEntry.siteId ?? 0)),
    tooltip: runTooltip,
    iconName: 'newspaper',
} only %}
    {%- endif -%}
    {%- set processAgainEntryId = runEntry is not null ? (runEntry.id ?? 0) : 0 -%}
    {%- if processAgainEntryId > 0 -%}
        {%- set canProcessAgain = (runEntry.canProcessAgain ?? false) == true -%}
<button type="button" class="bpts-transform-last-process-icon-btn bpts-process-again-button" data-bpts-process-again="true" data-entry-id="{{ processAgainEntryId }}" title="Process this entry again" aria-label="Process this entry again"{{ not canProcessAgain ? ' disabled aria-disabled="true"' : '' }}><span data-icon="refresh" aria-hidden="true"></span></button>
    {%- endif -%}
    {%- if runSourceUrl|trim != '' -%}
<a href="{{ runSourceUrl }}" target="_blank" rel="noopener" class="bpts-transform-last-process-icon-btn" title="Open processed page: {{ runSourceUrl }}" aria-label="Open processed page"><span data-icon="world" aria-hidden="true"></span></a>
    {%- endif -%}
</aside>
{%- endif -%}
