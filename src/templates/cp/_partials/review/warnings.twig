{#
    Review warnings list.

    Variables:
      - warnings          (list)   Each entry: { code, message, transforms?, rowCount?, entryId?, entryAvailable?, entryMissing? }.
      - showEmptyState    (bool)   Render the "No warnings detected." success chip when empty.
      - reviewMode        (string) 'processed' | 'saved'.
      - canEditTransforms (bool)   Telemetry guard.
#}
{%- if warnings is empty -%}
    {%- if showEmptyState -%}
<div class="bpts-warning-item bpts-warning-item-success">No warnings detected.</div>
    {%- endif -%}
{%- else -%}
    {%- for warning in warnings -%}
        {%- set code = warning.code ?? 'warning' -%}
        {%- set warningClass = code == 'missing-set-definitions'
            ? 'bpts-warning-item bpts-warning-item-danger'
            : 'bpts-warning-item bpts-warning-item-neutral'
        -%}
        {%- set label = code == 'missing-set-definitions' ? 'Transform Set Missing' : code -%}
        {%- set showObservedIcon = code == 'missing-set-definitions' and reviewMode == 'saved' and (warning.entryId ?? 0) > 0 -%}
    <div class="{{ warningClass }}"><div class="bpts-warning-copy"><h3 class="bpts-warning-heading">{% if showObservedIcon %}<span class="bpts-warning-observed-icon" aria-hidden="true" title="{{ 'Observed set'|t('breakpoints') }}"><span class="icon" data-icon="view"></span></span>{% endif %}{{ label }}</h3></div><div class="bpts-warning-detail"><p>{{ warning.message ?? 'Warning' }}</p></div>
        {%- if warning.transforms is defined and warning.transforms is iterable and warning.transforms|length > 0 -%}
<div class="bpts-warning-detail">{% for name in warning.transforms %}{% if not loop.first %}, {% endif %}{{ name }}{% endfor %}</div>
        {%- endif -%}
        {%- if warning.rowCount is defined and warning.rowCount is not null -%}
<div class="bpts-warning-detail">rows: {{ warning.rowCount }}</div>
        {%- endif -%}
{% include 'breakpoints/cp/_partials/review/warning-actions' with {
    code: code,
    reviewMode: reviewMode,
    canEditTransforms: canEditTransforms,
    entryId: warning.entryId ?? 0,
    entryAvailable: warning.entryAvailable ?? false,
    entryMissing: warning.entryMissing ?? false,
} only %}</div>
    {%- endfor -%}
{%- endif -%}