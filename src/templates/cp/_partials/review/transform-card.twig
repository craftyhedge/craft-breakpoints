                        <span class="icon" data-icon="settings" aria-hidden="true"></span>
                        <span class="bpts-transform-init-applied-label">Init options in use</span>
                    </span>
                </div>
                <div class="bpts-transform-note-preview {{ notesInput == '' ? 'bpts-force-hidden' : '' }}"
