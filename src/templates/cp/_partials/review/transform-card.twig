        data-attr:data-scope-breakpoint="$editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' ? String(Number($editor.cards.{{ signalKey }}.scopeBreakpoint || 0) || '') : ''"
        data-attr:data-scope-breakpoint-key="$editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' ? String($editor.cards.{{ signalKey }}.scopeBreakpointKey || '') : ''"
        data-attr:data-active-tab="$editor.cards.{{ signalKey }}.activeTab || 'dimensions'"
