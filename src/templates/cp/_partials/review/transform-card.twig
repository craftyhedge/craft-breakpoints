{#
    Transform card partial.

    All variables are pre-processed and pre-escaped by TransformEditor::renderResultReview(),
    so auto-escape is disabled to preserve byte-for-byte output parity with the legacy
    token-substitution template (transform-card-template.twig).

    Expected variables (all strings unless noted; see renderResultReview() for producers):
      - cardWarningStateClass, transformNameEscaped, signalKey
            - cardId
      - renderedRowsForTransformJson, selectedAssetKey
    - cardSignalsStructural
      - includeEscapeWidth, cardWarningsHtml, signalPathBase
      - passHeightIndicatorHiddenClass, breakpointColumns
      - renderedApplyHiddenClass, editScopeAllCheckedAttr
      - assetPaginationHtml, editPanelId
      - dimensions/ratio/settings tab class/selected/tabindex attrs
      - dimensionsPanelActiveClass, dimensionsPanelHiddenAttr
      - ratioPanelActiveClass, ratioPanelHiddenAttr
      - settingsPanelActiveClass, settingsPanelHiddenAttr
      - widthInputId, heightInputId, ratioWidthInputId, ratioHeightInputId
    - ratioFloatInputId
      - ratioSourceName, passHeightToggleId, allowAnyHeightToggleId
      - ratioSourceBreakpointOptions, lastProcessPanelHtml
#}
