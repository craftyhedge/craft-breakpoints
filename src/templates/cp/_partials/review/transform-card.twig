                    data-on:click__throttle.300ms="if(!window.confirm('Delete this transform set?')){ return; } const card=el.closest('.bpts-transform-card'); const setName=String($editor.cards.{{ signalKey }}.setName || card?.dataset?.set || ''); @post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName, operation: 'set.delete', baseVersion: String($editor.baseVersion || '')}})"><span class="icon" data-icon="trash" aria-hidden="true"></span></button>
