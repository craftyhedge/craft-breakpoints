widthInput.value='';} const hv=Number(heightInput?.value||0)||null; @post($_applyCardOperationUrl,{contentType:'json',headers:{'X-CSRF-Token':$_csrfToken},payload:{setName:sn,operation: 'dimensions.apply',includeEscapeWidth:iew,scopeMode:sm,scopeBreakpoint:sbp,forceAll:sm==='all',widthAuto:true,heightAuto:false,width:null,height:hv,baseVersion:bv}}) }">A</button>
                                        </div>
