                            <section id="{{ editPanelId }}-panel-ratio" role="tabpanel" aria-labelledby="{{ editPanelId }}-tab-ratio" class="bpts-transform-tab-panel {{ ratioPanelActiveClass }}" data-tab-panel="ratio" {{ ratioPanelHiddenAttr }} data-class:active="$editor.cards.{{ signalKey }}.activeTab === 'ratio'" data-attr:hidden="$editor.cards.{{ signalKey }}.activeTab === 'ratio' ? false : true">
