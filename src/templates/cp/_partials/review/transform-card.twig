{%- set autoOn -%}Number($editor.cards.{{ signalKey }}.widthAuto || 0) === 1 || Number($editor.cards.{{ signalKey }}.heightAuto || 0) === 1{%- endset -%}
{%- set disabledWhenInactiveOrAutoOn -%}{{ disabledWhenInactive }} || {{ autoOn }}{%- endset -%}
