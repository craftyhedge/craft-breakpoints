{#
    Transform card partial.

    All variables are pre-processed and pre-escaped by TransformEditor::renderResultReview(),
    so auto-escape is disabled to preserve byte-for-byte output parity with the legacy
    token-substitution template (transform-card-template.twig).

    Expected variables (all strings unless noted; see renderResultReview() for producers):
      - cardWarningStateClass, cardWarningDangerExpr, transformNameEscaped, signalKey
      - cardStatusSuccessHiddenClass, cardStatusWarningHiddenClass
            - cardId
      - renderedRowsForTransformJson: removed; server resolves rendered evidence
             - selectedAssetKey
    - cardSignalsStructural
      - includeEscapeWidth, cardWarningsHtml, signalPathBase
      - passHeightIndicatorHiddenClass, breakpointColumns
      - renderedApplyHiddenClass, deleteSetHiddenClass, editScopeAllCheckedAttr
      - assetPaginationHtml, editPanelId
      - dimensions/ratio/settings tab class/selected/tabindex attrs
      - dimensionsPanelActiveClass, dimensionsPanelHiddenAttr
      - ratioPanelActiveClass, ratioPanelHiddenAttr
      - settingsPanelActiveClass, settingsPanelHiddenAttr
      - notesPanelActiveClass, notesPanelHiddenAttr
      - widthInputId, heightInputId, ratioWidthInputId, ratioHeightInputId
    - ratioFloatInputId
      - ratioSourceName, passHeightToggleId, allowAnyHeightToggleId, notesInputId
      - ratioSourceBreakpointOptions, lastProcessPanelHtml
#}
{% autoescape false %}
{%- set disabledWhenInactive -%}String($editor.cards.{{ signalKey }}.scopeMode || 'unset') === 'unset'{%- endset -%}
{%- set autoOn -%}Number($editor.cards.{{ signalKey }}.widthAuto || 0) === 1 || Number($editor.cards.{{ signalKey }}.heightAuto || 0) === 1{%- endset -%}
{%- set disabledWhenInactiveOrAutoOn -%}{{ disabledWhenInactive }} || {{ autoOn }}{%- endset -%}
{%- set scopedInitSeedApplied -%}String($editor.cards.{{ signalKey }}.scopeMode||'') === 'breakpoint' && (($editor.cards.{{ signalKey }}.rowsByBreakpoint && $editor.cards.{{ signalKey }}.rowsByBreakpoint[String($editor.cards.{{ signalKey }}.scopeBreakpoint||'')]) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint[String($editor.cards.{{ signalKey }}.scopeBreakpoint||'')].initSeedApplied === true) : false){%- endset -%}
{%- set cardModePayload -%}hideRenderedApply: String($editor.cards.{{ signalKey }}.hideRenderedApply || '0') === '1', reviewMode: String($editor.cards.{{ signalKey }}.reviewMode || 'processed'), {%- endset -%}
{%- set ratioRecompute -%}const rwInput=document.getElementById('{{ ratioWidthInputId }}'); const rhInput=document.getElementById('{{ ratioHeightInputId }}'); const rfInput=document.getElementById('{{ ratioFloatInputId }}'); const rw=Number(rwInput?.value||0); const rh=Number(rhInput?.value||0); if(rw>0&&rh>0){ const raw=rw/rh; if(rfInput){ rfInput.value=raw.toFixed(4).replace(/\.0+$/,'').replace(/(\.\d*?)0+$/,'$1'); } } else if(rfInput){ rfInput.value=''; } $editor.cards.{{ signalKey }}.ratioWidthInput=String(rwInput?.value||''); $editor.cards.{{ signalKey }}.ratioHeightInput=String(rhInput?.value||''); $editor.cards.{{ signalKey }}.ratioFloatInput=String(rfInput?.value||''); $editor.cards.{{ signalKey }}.ratioLocked='0';{%- endset -%}
<section class="bpts-transform-card {{ cardWarningStateClass }}"
    id="{{ cardId }}"
        data-class:bpts-transform-card-warning="{{ cardWarningDangerExpr }}"
        data-set="{{ transformNameEscaped }}"
        data-signal-key="{{ signalKey }}"
        data-selected-asset-key="{{ selectedAssetKey }}"
        data-signals="{{ cardSignalsStructural }}"
