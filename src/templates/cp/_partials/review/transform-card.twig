<section class="bpts-transform-card {{ cardWarningStateClass }}"
    id="{{ cardId }}"
        data-set="{{ transformNameEscaped }}"
        data-signal-key="{{ signalKey }}"
        data-rendered-rows="{{ renderedRowsForTransformJson }}"
        data-selected-asset-key="{{ selectedAssetKey }}"
        data-signals="{{ cardSignalsStructural }}"
