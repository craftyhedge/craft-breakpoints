                        <span class="bpts-transform-update-status-icon bpts-transform-update-status-icon-success" aria-hidden="true"><span class="icon" data-icon="check"></span></span>
                        <span class="bpts-transform-update-status-label" data-role="transform-update-status-label"></span>
