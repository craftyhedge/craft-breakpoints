                                        <div class="bpts-transform-input-with-addon" data-class:bpts-transform-input-derived="Number($editor.cards.{{ signalKey }}.widthAuto||0)!==1 && Number($editor.cards.{{ signalKey }}.heightAuto||0)!==1 && Number($editor.cards.{{ signalKey }}.ratioLocked||0)===1 && Number($editor.cards.{{ signalKey }}.ratioWidthInput||0)>0 && Number($editor.cards.{{ signalKey }}.ratioHeightInput||0)>0 && String($editor.cards.{{ signalKey }}.ratioSourceDimension || 'width') === 'width'">
