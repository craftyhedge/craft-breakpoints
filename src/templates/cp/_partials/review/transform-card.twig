                    </div>
                </div>
                <span class="bpts-transform-edit-scope"><strong data-role="edit-scope-value" data-text="$editor.cards.{{ signalKey }}.scopeMode === 'all' ? 'All' : ($editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' ? (String(Number($editor.cards.{{ signalKey }}.scopeBreakpoint || 0)) + 'px') : 'Select a breakpoint to edit')">Select a breakpoint to edit</strong><span class="bpts-transform-ratio-scope-indicator" data-class:active="String($editor.cards.{{ signalKey }}.scopeMode||'')==='breakpoint' && Number($editor.cards.{{ signalKey }}.widthAuto||0)!==1 && Number($editor.cards.{{ signalKey }}.heightAuto||0)!==1 && Number($editor.cards.{{ signalKey }}.ratioLocked||0)===1 && Number($editor.cards.{{ signalKey }}.ratioWidthInput||0)>0 && Number($editor.cards.{{ signalKey }}.ratioHeightInput||0)>0">Ratio</span></span>
            </div>
        </section>
        <section class="bpts-transform-edit-panel" id="{{ editPanelId }}">
            {{ lastProcessPanelHtml }}
            <div class="bpts-transform-edit-layout">
