                    <span class="bpts-transform-update-status-icon bpts-transform-update-status-icon-success" aria-hidden="true"><span class="icon" data-icon="check"></span></span>
                    <span class="bpts-transform-update-status-label" data-role="transform-update-status-label"></span>
                </span>
                <span class="bpts-transform-init-applied-indicator"
                    role="img"
                    title="Init options in use"
                    aria-label="Init options in use"
                    data-class:bpts-force-hidden="$editor.cards.{{ signalKey }}.initSeedAppliedAny === true ? false : true">
                    <span class="icon" data-icon="settings" aria-hidden="true"></span>
                    <span class="bpts-transform-init-applied-label">Init options in use</span>
                </span>
            </div>
