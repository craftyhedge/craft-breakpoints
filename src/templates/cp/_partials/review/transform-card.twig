        data-attr:data-scope-breakpoint="$editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' ? String(Number($editor.cards.{{ signalKey }}.scopeBreakpoint || 0) || '') : ''"
        data-attr:data-active-tab="$editor.cards.{{ signalKey }}.activeTab || 'dimensions'"
        data-attr:data-selected-asset-key="$editor.cards.{{ signalKey }}.selectedAssetKey || ''"
        data-include-escape-width="{{ includeEscapeWidth }}">
        {{ cardWarningsHtml }}
        <input type="hidden" data-bind="{{ signalPathBase }}.setName" value="{{ transformNameEscaped }}">
        <input type="hidden" data-bind="{{ signalPathBase }}.includeEscapeWidth" value="{{ includeEscapeWidth }}">
