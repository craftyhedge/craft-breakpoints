                <input type="checkbox" class="bpts-transform-edit-all-checkbox" value="all" {{ editScopeAllCheckedAttr }} data-attr:checked="$editor.cards.{{ signalKey }}.scopeMode === 'all' ? true : null" data-on:change="const firstBreakpoint=Number($editor.cards.{{ signalKey }}.firstBreakpoint || 0) || null; const firstBreakpointKey=String($editor.cards.{{ signalKey }}.firstBreakpointKey || ''); const operation=el.checked ? 'scope.selectAll' : 'scope.selectBreakpoint'; if(operation==='scope.selectBreakpoint' && (firstBreakpoint===null || firstBreakpointKey==='')){ return; } const card=el.closest('.bpts-transform-card'); @post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation, scopeBreakpoint: operation==='scope.selectBreakpoint' ? firstBreakpoint : null, scopeBreakpointKey: operation==='scope.selectBreakpoint' ? firstBreakpointKey : '', selectedAssetKey: String(card?.dataset?.selectedAssetKey || ''), baseVersion: String($editor.baseVersion || '')}})">
                <span>Select All</span>
            </label>
        </div>
        {{ assetPaginationHtml }}
