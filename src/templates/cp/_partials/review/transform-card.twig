                        </svg>
                    </button>
                    <div class="bpts-transform-note-preview-body" data-text="$editor.cards.{{ signalKey }}.notesInput || ''">{{ notesInput }}</div>
                </div>
            </div>
            <div class="bpts-transform-header-actions">
                <button type="button" class="btn small bpts-transform-delete-set {{ deleteSetHiddenClass }}"
