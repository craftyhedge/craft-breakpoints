                    title="Height tolerance is enabled"
                    aria-label="Height tolerance is enabled"
                    data-class:bpts-force-hidden="$editor.cards.{{ signalKey }}.passHeightWhenRenderedLteSaved === true || $editor.cards.{{ signalKey }}.allowAnyHeight === true ? false : true"
                    data-attr:title="$editor.cards.{{ signalKey }}.allowAnyHeight === true ? 'Allow Any Height is enabled' : ($editor.cards.{{ signalKey }}.passHeightWhenRenderedLteSaved === true ? 'Allow Shorter heights is enabled' : '')"
                    data-attr:aria-label="$editor.cards.{{ signalKey }}.allowAnyHeight === true ? 'Allow Any Height is enabled' : ($editor.cards.{{ signalKey }}.passHeightWhenRenderedLteSaved === true ? 'Allow Shorter heights is enabled' : '')">
                    <svg class="bpts-transform-pass-height-indicator-svg" viewBox="0 0 20 20" focusable="false" aria-hidden="true">
                        <rect x="2.5" y="3.5" width="8" height="13" rx="1.2" class="bpts-transform-pass-height-indicator-ruler"></rect>
                        <path d="M5 6.5h2.5M5 8.8h1.8M5 11.1h2.5M5 13.4h1.8" class="bpts-transform-pass-height-indicator-ticks"></path>
                        <path d="M11.4 12.3l2.2 2.2 3.9-4.1" class="bpts-transform-pass-height-indicator-check"></path>
                    </svg>
                </span>
                <span class="bpts-transform-update-status" data-role="transform-update-status" data-state="idle" aria-live="polite" aria-label="">
