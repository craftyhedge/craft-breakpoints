{#
    Breakpoint column partial.

    All variables are pre-processed and pre-escaped by TransformEditor::renderReviewBreakpointColumn(),
    so we disable auto-escape to preserve byte-for-byte output parity with the legacy
    token-substitution template (breakpoint-column-template.twig).

    Variables (all strings unless noted):
      - breakpointColumnSelectedClass
      - breakpointColumnMismatchClass
      - breakpointColumnDisabledClass
      - breakpoint
      - breakpointColumnWidth
      - previewLockHeight
      - signalKey
      - currentWidthValue
      - currentHeightValue
      - currentRatioWidthValue
      - currentRatioHeightValue
      - currentRatioFloatValue
      - currentRatioSourceDimension
      - currentRatioLockedValue
      - currentEnabledValue
      - currentAutoDimension
      - escapeBadge
      - hiddenBadge
      - unloadedBadge
      - breakpointEnableOnClass
      - breakpointEnableTitle
      - breakpointEnableAriaLabel
      - breakpointEnableAriaChecked
      - renderedRowsPayloadJson
      - breakpointDisabledAttr
      - breakpointRenderedApplyMatchClass
      - breakpointRenderedApplyAriaLabel
      - breakpointRenderedApplyTitle
      - breakpointRenderedApplyIconName
      - breakpointRenderedApplyHiddenClass
      - breakpointRenderedRowHiddenClass
      - relativeWidth
      - previewMedia
      - widthClass
      - heightClass
      - renderedWidth
      - renderedHeight
      - currentWidth
      - currentHeight
      - currentWidthDerivedClass
      - currentHeightDerivedClass
#}
{% autoescape false %}
{%- set breakpointEnableToggleBody -%}@post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'breakpoint.toggleEnabled', includeEscapeWidth: String($editor.cards.{{ signalKey }}.includeEscapeWidth || '0') === '1', scopeBreakpoint: Number({{ breakpoint }}) || null, baseVersion: String($editor.baseVersion || '')}}){%- endset -%}
<div class="bpts-breakpoint-column {{ breakpointColumnSelectedClass }} {{ breakpointColumnMismatchClass }} {{ breakpointColumnDisabledClass }}" data-breakpoint="{{ breakpoint }}" style="--bpts-breakpoint-column-width:{{ breakpointColumnWidth }}px; --bpts-preview-lock-height:{{ previewLockHeight }}px;"
        data-class:bpts-breakpoint-column-selected="$editor.cards.{{ signalKey }}.scopeMode === 'all' || ($editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' && Number($editor.cards.{{ signalKey }}.scopeBreakpoint || 0) === {{ breakpoint }})"
    data-on:click="if(evt&&evt.target&&evt.target.closest('.bpts-rendered-apply-single, .bpts-breakpoint-enable-toggle-wrap')){return;} @post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'scope.selectBreakpoint', scopeBreakpoint: Number({{ breakpoint }}) || null, baseVersion: String($editor.baseVersion || '')}})">
        <div class="bpi_breakpoint-size-heading">
            <span>{{ breakpoint }}px</span>
            {{ escapeBadge }}
            {{ hiddenBadge }}
            {{ unloadedBadge }}
            <div class="bpts-breakpoint-column-actions">
                <div class="lightswitch small bpts-breakpoint-enable-toggle-wrap {{ breakpointEnableOnClass }}" data-bpts-action="breakpointEnabled" title="{{ breakpointEnableTitle }}" role="switch" tabindex="0" aria-label="{{ breakpointEnableAriaLabel }}" aria-checked="{{ breakpointEnableAriaChecked }}"
                    data-class:on="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].enabled ? '1' : '0') : '1') === '1'"
                    data-on:click__throttle.300ms="{{ breakpointEnableToggleBody }}"
                    data-on:keydown="if(!evt|| (evt.key!=='Enter' && evt.key!==' ')){return;} evt.preventDefault(); {{ breakpointEnableToggleBody }}">
                    <div class="lightswitch-container">
                        <div class="handle"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="bpi_image-display-section">
            <div class="bpi_breakpoint-result-wrapper">
                <div class="bpi_breakpoint-result">
                    <div class="bpi_image-outer" style="--bpts-relative-width:{{ relativeWidth }}%;">
                        {{ previewMedia }}
                    </div>
                </div>
            </div>
            <span class="bpi_current-ratio bpi_current-ratio-overlay"
                data-class:bpts-force-hidden="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].ratioLocked || '0') : '0') !== '1'"
                data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].ratioOverlayText || '') : '')"></span>
        </div>
        <div class="bpts-dimension-table-wrap">
            <div class="bpts-dimension-matrix" role="table" aria-label="Rendered and current dimensions">
                <div class="bpts-dimension-row {{ breakpointRenderedRowHiddenClass }}" role="row">
                    <span class="bpts-dimension-icon bpts-dimension-icon-rendered" role="rowheader" title="Rendered" aria-label="Rendered">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <rect x="2.5" y="3" width="11" height="8.5" rx="1.5"></rect>
                            <path d="M4.4 5.2h2"></path>
                            <path d="M3.5 10.8l3.1-2.8 2.2 2 2-1.6 2.2 2.4"></path>
                        </svg>
                    </span>
                    <span class="bpi_rendered-dimension {{ widthClass }}" role="cell">{{ renderedWidth }}</span>
                    <span class="bpi_rendered-dimension {{ heightClass }}" role="cell">{{ renderedHeight }}</span>
                </div>
                <button type="button" class="btn bpts-rendered-apply-single {{ breakpointRenderedApplyMatchClass }} {{ breakpointRenderedApplyHiddenClass }}"
                    data-bpts-action="renderedValues"
                    aria-label="{{ breakpointRenderedApplyAriaLabel }}"
                    title="{{ breakpointRenderedApplyTitle }}"
                    data-rendered-rows="{{ renderedRowsPayloadJson }}"
                    {{ breakpointDisabledAttr }}
                    data-on:click__throttle.300ms="@post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'renderedValues.apply', includeEscapeWidth: String($editor.cards.{{ signalKey }}.includeEscapeWidth || '0') === '1', renderedRows: String(el.dataset.renderedRows || '[]'), baseVersion: String($editor.baseVersion || '')}})">
                    <span class="icon bpts-rendered-apply-icon" data-icon="{{ breakpointRenderedApplyIconName }}" aria-hidden="true"></span>
                </button>
                <div class="bpts-dimension-row" role="row">
                    <span class="bpts-dimension-icon bpts-dimension-icon-current" role="rowheader" title="Current" aria-label="Current">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M2.5 4h11"></path>
                            <path d="M2.5 8h11"></path>
                            <path d="M2.5 12h11"></path>
                            <circle cx="6" cy="4" r="1.2"></circle>
                            <circle cx="10.5" cy="8" r="1.2"></circle>
                            <circle cx="7.5" cy="12" r="1.2"></circle>
                        </svg>
                    </span>
                    <span class="bpi_current-dimension {{ currentWidthDerivedClass }}" data-dimension="width" role="cell" data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentWidthDisplay || '-') : '-')" data-class:bpts-init-value="($editor.cards.{{ signalKey }}.rowsByBreakpoint && $editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].initSeedApplied === true) : false">{{ currentWidth }}</span>
                    <span class="bpi_current-dimension {{ currentHeightDerivedClass }}" data-dimension="height" role="cell" data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentHeightDisplay || '-') : '-')" data-class:bpts-init-value="($editor.cards.{{ signalKey }}.rowsByBreakpoint && $editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].initSeedApplied === true) : false">{{ currentHeight }}</span>
                </div>
            </div>
        </div>
    </div>{% endautoescape %}
