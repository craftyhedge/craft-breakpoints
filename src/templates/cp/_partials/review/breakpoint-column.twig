{#
    Breakpoint column partial.

    All variables are pre-processed and pre-escaped by TransformEditor::renderReviewBreakpointColumn(),
    so we disable auto-escape to preserve byte-for-byte output parity with the legacy
    token-substitution template (breakpoint-column-template.twig).

    Variables (all strings unless noted):
      - breakpointColumnSelectedClass
      - breakpointColumnMismatchClass
      - breakpointColumnDisabledClass
      - breakpoint
      - breakpointKey
      - breakpointColumnWidth
      - breakpointRangeLabel
      - previewLockHeight
      - signalKey
      - currentWidthValue
      - currentHeightValue
      - currentRatioWidthValue
      - currentRatioHeightValue
      - currentRatioFloatValue
      - currentRatioSourceDimension
      - currentRatioLockedValue
      - currentEnabledValue
      - currentAutoDimension
      - escapeBadge
      - hiddenBadge
      - unloadedBadge
      - breakpointEnableOnClass
      - breakpointEnableTitle
      - breakpointEnableAriaLabel
      - breakpointEnableAriaChecked
       - breakpointDisabledAttr
      - breakpointRenderedApplyMatchClass
      - breakpointRenderedApplyAriaLabel
      - breakpointRenderedApplyTitle
      - breakpointRenderedApplyIconName
      - breakpointRenderedApplyHiddenClass
      - breakpointRenderedRowHiddenClass
      - relativeWidth
      - previewMedia
      - widthClass
      - heightClass
      - renderedWidth
      - renderedHeight
      - currentWidth
      - currentHeight
      - currentWidthDerivedClass
      - currentHeightDerivedClass
#}
{% autoescape false %}
{%- set cardModePayload -%}hideRenderedApply: String($editor.cards.{{ signalKey }}.hideRenderedApply || '0') === '1', reviewMode: String($editor.cards.{{ signalKey }}.reviewMode || 'processed'), {%- endset -%}
{%- set breakpointEnableToggleBody -%}@post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'breakpoint.toggleEnabled', includeEscapeWidth: String($editor.cards.{{ signalKey }}.includeEscapeWidth || '0') === '1', scopeBreakpoint: Number({{ breakpoint }}) || null, scopeBreakpointKey: '{{ breakpointKey }}', {{ cardModePayload }} baseVersion: String($editor.baseVersion || '')}}){%- endset -%}
<div class="bpts-breakpoint-column-wrap" style="--bpts-breakpoint-column-width:{{ breakpointColumnWidth }}px; --bpts-preview-lock-height:{{ previewLockHeight }}px;">
    <h3 class="bpts-breakpoint-column-key">{{ breakpointKey }}</h3>
    <div class="bpts-breakpoint-column {{ breakpointColumnSelectedClass }}" data-breakpoint="{{ breakpoint }}" data-breakpoint-key="{{ breakpointKey }}" data-breakpoint-width="{{ breakpoint }}"
        data-class:bpts-breakpoint-column-selected="$editor.cards.{{ signalKey }}.scopeMode === 'all' || ($editor.cards.{{ signalKey }}.scopeMode === 'breakpoint' && Number($editor.cards.{{ signalKey }}.scopeBreakpoint || 0) === {{ breakpoint }})"
        data-class:bpts-breakpoint-column-mismatch="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointColumnMismatchClass || '0') : '0') === '1'"
        data-class:bpts-breakpoint-column-disabled="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointColumnDisabledClass || '0') : '0') === '1'"
    data-on:click="if(evt&&evt.target&&evt.target.closest('.bpts-rendered-apply-single, .bpts-breakpoint-enable-toggle-wrap')){return;} const card=el.closest('.bpts-transform-card'); @post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'scope.selectBreakpoint', scopeBreakpoint: Number({{ breakpoint }}) || null, scopeBreakpointKey: '{{ breakpointKey }}', selectedAssetKey: String(card?.dataset?.selectedAssetKey || ''), includeEscapeWidth: String($editor.cards.{{ signalKey }}.includeEscapeWidth || '0') === '1', activeTab: String($editor.cards.{{ signalKey }}.activeTab || 'dimensions'), baseVersion: String($editor.baseVersion || '')}})">
        <div class="bpi_breakpoint-size-heading">
            <span>{{ breakpointRangeLabel }}</span>
            {{ escapeBadge }}
            {{ hiddenBadge }}
            {{ unloadedBadge }}
            <div class="bpts-breakpoint-column-actions">
                <div class="lightswitch small bpts-breakpoint-enable-toggle-wrap" data-bpts-action="breakpointEnabled" role="switch" tabindex="0"
                    data-class:on="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].enabled ? '1' : '0') : '1') === '1'"
                    data-attr:title="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointEnableTitle || '') : ''"
                    data-attr:aria-label="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointEnableAriaLabel || '') : ''"
                    data-attr:aria-checked="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointEnableAriaChecked || 'false') : 'false'"
                    data-on:click__throttle.300ms="{{ breakpointEnableToggleBody }}"
                    data-on:keydown="if(!evt|| (evt.key!=='Enter' && evt.key!==' ')){return;} evt.preventDefault(); {{ breakpointEnableToggleBody }}">
                    <div class="lightswitch-container">
                        <div class="handle"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="bpi_image-display-section">
            <div class="bpi_breakpoint-result-wrapper">
                <div class="bpi_breakpoint-result">
                    <div class="bpi_image-outer" style="--bpts-relative-width:{{ relativeWidth }}%;"
                        data-class:bpts-force-hidden="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].previewMediaHidden || '0') : '0') === '1'">
                        {{ previewMedia }}
                    </div>
                </div>
            </div>
            <span class="bpi_current-ratio bpi_current-ratio-overlay"
                data-class:bpts-force-hidden="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].ratioLocked || '0') : '0') !== '1'"
                data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].ratioOverlayText || '') : '')"></span>
        </div>
        <div class="bpts-dimension-table-wrap">
            <div class="bpts-dimension-matrix" role="table" aria-label="Rendered and current dimensions">
                <div class="bpts-dimension-row" role="row"
                    data-class:bpts-force-hidden="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedRowHiddenClass || '0') : '0') === '1'">
                    <span class="bpts-dimension-icon bpts-dimension-icon-rendered" role="rowheader" title="Rendered" aria-label="Rendered">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <rect x="2.5" y="3" width="11" height="8.5" rx="1.5"></rect>
                            <path d="M4.4 5.2h2"></path>
                            <path d="M3.5 10.8l3.1-2.8 2.2 2 2-1.6 2.2 2.4"></path>
                        </svg>
                    </span>
                    <span class="bpi_rendered-dimension {{ widthClass }}" role="cell"
                        data-class:bpi_dimension-auto="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-auto'"
                        data-class:bpi_dimension-no-transform="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-no-transform'"
                        data-class:bpi_dimension-match="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-match'"
                        data-class:bpi_dimension-mismatch="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-mismatch'"
                        data-class:bpi_dimension-stale="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-stale'"
                        data-class:bpi_dimension-allowed="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].widthClass || '') : '') === 'bpi_dimension-allowed'">{{ renderedWidth }}</span>
                    <span class="bpi_rendered-dimension {{ heightClass }}" role="cell"
                        data-class:bpi_dimension-auto="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-auto'"
                        data-class:bpi_dimension-no-transform="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-no-transform'"
                        data-class:bpi_dimension-match="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-match'"
                        data-class:bpi_dimension-mismatch="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-mismatch'"
                        data-class:bpi_dimension-stale="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-stale'"
                        data-class:bpi_dimension-allowed="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].heightClass || '') : '') === 'bpi_dimension-allowed'">{{ renderedHeight }}</span>
                </div>
                <button type="button" class="btn bpts-rendered-apply-single"
                    data-bpts-action="renderedValues"
                    data-class:bpts-rendered-apply-single-noop="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedApplyMatchClass || '0') : '0') === '1'"
                    data-class:bpts-force-hidden="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedApplyHiddenClass || '0') : '0') === '1'"
                    data-attr:aria-label="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedApplyAriaLabel || '') : ''"
                    data-attr:title="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedApplyTitle || '') : ''"
                    data-attr:disabled="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointDisabledAttr || '0') : '0') === '1' ? 'disabled' : null"
                    data-on:click__throttle.300ms="@post($_applyCardOperationUrl, {contentType: 'json', headers: {'X-CSRF-Token': $_csrfToken}, payload: {setName: String($editor.cards.{{ signalKey }}.setName || ''), operation: 'renderedValues.apply', includeEscapeWidth: String($editor.cards.{{ signalKey }}.includeEscapeWidth || '0') === '1', scopeMode: 'breakpoint', scopeBreakpoint: Number({{ breakpoint }}) || null, scopeBreakpointKey: '{{ breakpointKey }}', selectedAssetKey: String(el.closest('.bpts-transform-card')?.dataset?.selectedAssetKey || ''), hiddenBreakpoints: $editor.cards.{{ signalKey }}.processedHiddenBreakpoints || [], activeTab: String($editor.cards.{{ signalKey }}.activeTab || 'dimensions'), {{ cardModePayload }} baseVersion: String($editor.baseVersion || '')}})">
                    <span class="icon bpts-rendered-apply-icon" data-attr:data-icon="($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].breakpointRenderedApplyIconName || 'arrow-down') : 'arrow-down'" aria-hidden="true"></span>
                </button>
                <div class="bpts-dimension-row" role="row">
                    <span class="bpts-dimension-icon bpts-dimension-icon-current" role="rowheader" title="Current" aria-label="Current">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M2.5 4h11"></path>
                            <path d="M2.5 8h11"></path>
                            <path d="M2.5 12h11"></path>
                            <circle cx="6" cy="4" r="1.2"></circle>
                            <circle cx="10.5" cy="8" r="1.2"></circle>
                            <circle cx="7.5" cy="12" r="1.2"></circle>
                        </svg>
                    </span>
                    <span class="bpi_current-dimension" data-dimension="width" role="cell" data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentWidthDisplay || '-') : '-')" data-class:bpi_current-dimension-derived="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentWidthDerivedClass || '0') : '0') === '1'" data-class:bpi_current-dimension-edited="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentWidthEditedClass || '0') : '0') === '1'" data-class:bpts-init-value="($editor.cards.{{ signalKey }}.rowsByBreakpoint && $editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].initSeedApplied === true) : false">{{ currentWidth }}</span>
                    <span class="bpi_current-dimension" data-dimension="height" role="cell" data-text="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentHeightDisplay || '-') : '-')" data-class:bpi_current-dimension-derived="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentHeightDerivedClass || '0') : '0') === '1'" data-class:bpi_current-dimension-edited="String(($editor.cards.{{ signalKey }}.rowsByBreakpoint&&$editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].currentHeightEditedClass || '0') : '0') === '1'" data-class:bpts-init-value="($editor.cards.{{ signalKey }}.rowsByBreakpoint && $editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}']) ? ($editor.cards.{{ signalKey }}.rowsByBreakpoint['{{ breakpoint }}'].initSeedApplied === true) : false">{{ currentHeight }}</span>
                </div>
            </div>
        </div>
    </div>
</div>{% endautoescape %}
