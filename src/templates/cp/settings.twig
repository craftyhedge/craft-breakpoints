{% extends "_layouts/cp" %}
{% set title = 'Settings'|t('breakpoints') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'settings' %}
{% set fullPageForm = true %}

{% set formActions = [
    {
        label: 'Save and continue editing'|t('app'),
        redirect: 'breakpoints/settings'|hash,
        shortcut: true,
        retainScroll: true,
    },
] %}

{% set formatsTabClass = settings.getErrors('format') or settings.getErrors('secondaryFormat') or settings.getErrors('quality') or settings.getErrors('interlace') or settings.getErrors('dpr') ? 'error' : '' %}
{% set loadingTabClass = settings.getErrors('nativeLazyLoadingEnabled') or settings.getErrors('processingLazyLoadingAdapter') or settings.getErrors('processingLazyLoadingSrcAttribute') or settings.getErrors('processingLazyLoadingSrcsetAttribute') or settings.getErrors('processingLazyLoadingSizesAttribute') or settings.getErrors('processingLazyLoadingCustomHandler') ? 'error' : '' %}
{% set behaviorTabClass = settings.getErrors('mode') or settings.getErrors('allowUpscale') or settings.getErrors('defaultWidth') or settings.getErrors('defaultHeight') ? 'error' : '' %}
{% set editorTabClass = settings.getErrors('previewCenter') ? 'error' : '' %}
{% set templatesTabClass = settings.getErrors('pictureTemplatePath') or settings.getErrors('svgTemplatePath') ? 'error' : '' %}

{% set tabs = {
    formats: { label: 'Output & Quality'|t('breakpoints'), url: '#formats', class: formatsTabClass },
    loading: { label: 'Loading'|t('breakpoints'), url: '#loading', class: loadingTabClass },
    behavior: { label: 'Transform Settings'|t('breakpoints'), url: '#behavior', class: behaviorTabClass },
    templates: { label: 'Templates'|t('breakpoints'), url: '#templates', class: templatesTabClass },
    editor: { label: 'Editor UI'|t('breakpoints'), url: '#editor', class: editorTabClass },
    database: { label: 'Database'|t('breakpoints'), url: '#database' }
} %}

{% set selectedTab = craft.app.request.getParam('tab') ?? 'formats' %}

{% block actionButton %}
    <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
{% endblock %}

{% block content %}
    {{ actionInput('plugins/save-plugin-settings') }}
    {{ hiddenInput('pluginHandle', 'breakpoints') }}
    {{ redirectInput('breakpoints/settings') }}

    {% include 'breakpoints/settings' with {
        settings: settings,
        selectedTab: selectedTab,
        useTabs: true,
    } only %}
{% endblock %}
