{% extends "_layouts/cp" %}

{% set title = 'Transform Sets'|t('craft-breakpoint-images') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'transforms' %}

{% block content %}
    {% set setNames = setNames ?? [] %}
    {% set manifestSets = manifestSets ?? {} %}

    {% if setNames|length %}
        <ul>
            {% for setName in setNames %}
                {% set setDefinition = manifestSets[setName] ?? {} %}
                {% set breakpointCount = (setDefinition.variants is defined and setDefinition.variants is iterable)
                    ? setDefinition.variants|length
                    : 0 %}
                <li>
                    <strong>{{ setName }}</strong>
                    <span class="light">({{ breakpointCount }} breakpoints)</span>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>{{ 'No transform sets found in manifest.'|t('craft-breakpoint-images') }}</p>
    {% endif %}
{% endblock %}
