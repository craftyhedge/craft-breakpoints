{% extends "_layouts/cp" %}

{% set title = 'Transforms'|t('craft-breakpoint-images') %}
{% set selectedSubnavItem = selectedSubnavItem ?? 'transforms' %}

{% block content %}
    {% set transformNames = transformNames ?? [] %}
    {% set manifestTransforms = manifestTransforms ?? {} %}

    {% if transformNames|length %}
        <ul>
            {% for transformName in transformNames %}
                {% set transformDefinition = manifestTransforms[transformName] ?? {} %}
                {% set breakpointCount = (transformDefinition.transforms is defined and transformDefinition.transforms is iterable)
                    ? transformDefinition.transforms|length
                    : 0 %}
                <li>
                    <strong>{{ transformName }}</strong>
                    <span class="light">({{ breakpointCount }} breakpoints)</span>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>{{ 'No transforms found in manifest.'|t('craft-breakpoint-images') }}</p>
    {% endif %}
{% endblock %}
