{
    "name": "craftyhedge/craft-breakpoint-images",
    "description": "Craft CMS 5 plugin for responsive breakpoint image helpers.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "craftcms",
        "plugin",
        "images",
        "responsive"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "craftyhedge",
            "homepage": "https://github.com/craftyhedge"
        }
    ],
    "support": {
        "issues": "https://github.com/craftyhedge/craft-breakpoint-images/issues",
        "source": "https://github.com/craftyhedge/craft-breakpoint-images",
        "docs": "https://github.com/craftyhedge/craft-breakpoint-images/blob/main/README.md"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0",
        "starfederation/datastar-php": "1.0.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.2",
        "codeception/module-yii2": "^1.1",
        "craftcms/phpstan": "dev-main@dev",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "craftyhedge\\craftbreakpointimages\\": "src/"
        }
    },
    "extra": {
        "name": "Breakpoint Images",
        "handle": "craft-breakpoint-images",
        "class": "craftyhedge\\craftbreakpointimages\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "test": "codecept run unit",
        "test:integration": "codecept run integration",
        "test:all": "codecept run",
        "phpstan": "phpstan --memory-limit=1G"
    }
}